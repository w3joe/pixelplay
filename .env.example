# Resend (optional — leads always log to server console)
RESEND_API_KEY=
LEADS_TO_EMAIL=sales@example.com
LEADS_FROM_EMAIL=PixelPlay <onboarding@resend.dev>

# Gemini for /api/ai-plan (AI planner card). Pick one provider.
# Without credentials the card shows a friendly "not configured" message.
#
# GEMINI_PROVIDER=developer  → Google AI Studio / Gemini Developer API
# GEMINI_PROVIDER=vertex     → Vertex AI (same Gemini model ids)
GEMINI_PROVIDER=developer
GEMINI_MODEL=gemini-3.1-flash-lite

# Shared / developer key (also accepted as fallback for Vertex)
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # optional alias for GEMINI_API_KEY

# Vertex AI (only required when GEMINI_PROVIDER=vertex)
# Prefer VERTEX_API_KEY; falls back to GEMINI_API_KEY / GOOGLE_API_KEY if unset.
VERTEX_API_KEY=
VERTEX_PROJECT_ID=
# GOOGLE_CLOUD_PROJECT=   # optional alias for VERTEX_PROJECT_ID
VERTEX_LOCATION=us-central1
# GOOGLE_CLOUD_LOCATION=  # optional alias for VERTEX_LOCATION (use "global" for global endpoint)
