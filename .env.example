# Resend (optional — leads always log to server console)
RESEND_API_KEY=
LEADS_TO_EMAIL=sales@example.com
LEADS_FROM_EMAIL=PixelPlay <onboarding@resend.dev>

# Gemini (server-side only — used by /api/ai-plan for the AI planner card;
# without it, the card shows a friendly "not configured" message and the
# rest of the app works unaffected)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
